<Project Sdk="Cosmos.Sdk/3.0.96">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
	<NoWarn>$(NoWarn);COSMOS0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Fonts\PSF\Spleen.psfu" />
    <None Remove="Resources\Scripts\ktsh.lua" />
    <None Remove="Resources\Scripts\Libraries\commands.lua" />
    <None Remove="Resources\Scripts\Libraries\tokenizer.lua" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Fonts\PSF\Spleen.psfu" />
    <EmbeddedResource Include="Resources\Scripts\ktsh.lua" />
    <EmbeddedResource Include="Resources\Scripts\Libraries\commands.lua" />
    <EmbeddedResource Include="Resources\Scripts\Libraries\tokenizer.lua" />
  </ItemGroup>

  <!-- Core kernel packages -->
  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel" Version="3.0.96" />
    <PackageReference Include="Cosmos.Kernel.System" Version="3.0.96" />
  </ItemGroup>

  <!--literally anything else-->
  <ItemGroup>
	<PackageReference Include="Cosmos.Executable.Lua" Version="4.0.1" />
  </ItemGroup>
</Project>
