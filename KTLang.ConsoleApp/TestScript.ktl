# This is a comment.

fn log(source, message)
{
	println("[" + source + "]", message);
}

fn variableTest()
{
	var a = 10;
	println(a);
}

fn mathTest()
{
	var a = 10;
	var b = 20;

	var c = a + b; # addition
	var d = a - b; # subtraction
	var e = a * b; # multiplication
	var f = a / b; # division
	var g = a % b; # modulo

	println("a =", a);
	println("b =", b);
	println("c =", c);
	println("d =", d);
	println("e =", e);
	println("f =", f);
	println("g =", g);
}

fn ifTest(condition)
{
	if condition
	{
		println("Provided condition is true");
	}
	else
	{
		println("Provided condition is false");
	}
}

fn whileTest()
{
	var i = 0;

	while i < 10
	{
		println("i =", i);
		i = i + 1;
	}
}

fn arrayTest()
{
	var arr = [1, 2, 3, 4, 5, 6];

	println("Array length:", arr.length);
	println(arr);
	
	log("Arrays", "Pushing new element");
	arr.push(7);

	println("Array length after push:", arr.length);
	println(arr);

	log("Arrays", "Popping last element");
	var last = arr.pop();

	println("Array length after pop:", arr.length);
	println("Last element:", last);
}

fn stringTest()
{
	var str = "Hello, world!";
	var strLen = str.length;

	println("str =", str);
	println("strLen =", strLen);

	var strConcat = str + " String concatenation!";
	var newLen = strConcat.length;

	println("strConcat =", strConcat);
	println("newLen =", newLen);
}

fn conversionTest()
{
	var validNumStr = "100";
	var invalidNumStr = "Invalid";

	println("validNumStr =", validNumStr);
	println("invalidNumStr =", invalidNumStr);

	var validNum = toNumber(validNumStr);
	println("validNum =", validNum);

	# var invalidNum = toNumber(invalidNumStr); # ERROR!
	# println("invalidNum =", invalidNum);

	println("true (stringified) =", toString(true));
	println("1 (stringified) =", toString(1));
	println("[1, 2] (stringified) =", toString([1, 2]));
}

log("Variables", "Testing variable definition");
variableTest();

log("Math", "Testing math operations");
mathTest();

log("If", "Testing if statement (true)");
ifTest(true);

log("If", "Testing if statement (false)");
ifTest(false);

log("While", "Testing while statement");
whileTest();

log("Arrays", "Testing arrays");
arrayTest();

log("Strings", "Testing strings");
stringTest();

log("Conversion", "Testing number-to-string and string-to-number conversion");
conversionTest();

log("Tests", "Finished!");