var arr = [1, 2, 3, 4, 5, 6];
println("There are", arr.length, "elements in sample array");

arr.push(10);

println("There are now", arr.length, "elements!");

var last = arr.pop();

println("There are now", arr.length, "elements because the script popped one!");
println("Last element before popping:", last);

